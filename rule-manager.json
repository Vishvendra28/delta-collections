{
  "version": "1.0",
  "lastUpdated": "2026-07-20",
  "description": "Delta Collections Rule Manager — maps bank narration keywords to canonical customer names",

  "criticalFixes": [
    {
      "id": "FIX-001",
      "note": "CITIN266 is Citibank routing code used by MULTIPLE companies — must require company name alongside it. Never use CITIN266 alone as a rule."
    },
    {
      "id": "FIX-002",
      "note": "ITC LIMITED — 'ITC' is only 3 chars so use full phrase 'ITC LIMITED' or 'ITC LTD' as keyword, never just 'ITC' alone."
    },
    {
      "id": "FIX-003",
      "note": "Short company names (4 chars or less) must always use 2-word phrase as keyword to avoid false positives."
    }
  ],

  "excludePatterns": [
    { "pattern": "^BRN",         "reason": "Branch transfer — not a customer collection" },
    { "pattern": "^RTGS",        "reason": "RTGS internal — not NEFT collection" },
    { "pattern": "^INB",         "reason": "Internet banking transfer" },
    { "pattern": "^TD",          "reason": "Term Deposit" },
    { "pattern": "Int.Coll",     "reason": "Bank interest — not a customer payment" },
    { "pattern": "Escrow Trf",   "reason": "Internal escrow transfer" },
    { "pattern": "REFUND OF ESCROW", "reason": "Internal escrow refund" },
    { "pattern": "ZAST LOGISOLUT-Transin", "reason": "Internal inter-account transfer Zast to Transin" },
    { "pattern": "ZAST LOGISOLUT-Zast",    "reason": "Internal inter-company transfer" },
    { "pattern": "REV-IMPS",     "reason": "Reversal of IMPS payment — not a collection" },
    { "pattern": "NEFT RETURN",  "reason": "Bounced NEFT — not a collection" },
    { "pattern": "DELHIVERY",    "reason": "Delhivery Limited — logistics vendor, not a customer" },
    { "pattern": "VENTURA TRADIN", "reason": "Ventura Trading — not a customer" },
    { "pattern": "SCORPION EXPRESS", "reason": "Scorpion Express Pvt Ltd — not a customer" }
  ],

  "rules": [
    {
      "id": "R-001",
      "customer": "HINDUSTAN UNILEVER LIMITED",
      "kam": "Latha",
      "keywords": ["HINDUSTAN UNILEVER", "HINDUNILVR"],
      "compoundRules": [
        { "allOf": ["CITIN266", "HINDUSTAN UNILEVER"], "note": "CITIN266 alone is NOT enough — must also contain company name" }
      ],
      "exclude": ["CITIN266"],
      "note": "CRITICAL: Do NOT use CITIN266 alone — Perfetti, Voltas, Pidilite, SGIPL all use same Citibank routing"
    },
    {
