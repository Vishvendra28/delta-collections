# Postgres connection string.
#   Neon:             postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   Coolify Postgres: postgres://postgres:PASSWORD@<internal-hostname>:5432/postgres
DATABASE_URL=your_postgres_connection_string_here

# Signing key for auth tokens. Any long random string — `openssl rand -base64 48`.
# Changing this invalidates every issued token (all users must log in again).
JWT_SECRET=any_long_random_string_here

NODE_ENV=development
PORT=3001

# Postgres TLS. Leave unset to auto-detect (SSL on when NODE_ENV=production).
# Coolify's internal Postgres does NOT speak TLS — set DB_SSL=false there, or
# connections fail with "The server does not support SSL connections".
# DB_SSL=false
